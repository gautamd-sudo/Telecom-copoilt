# Application
NODE_ENV=development
PORT=3000
AI_SERVICE_PORT=8000

# Database
DATABASE_URL=postgres://user:password@localhost:5432/telecom_ai
TIMESCALEDB_URL=postgres://user:password@localhost:5432/telecom_ts

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# Authentication
JWT_SECRET=super_secret_key_change_in_production
JWT_EXPIRATION=1h

# LLM Configuration
LLM_PROVIDER=nvidia # Options: nvidia, openai, anthropic, gemini
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4.1-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Object Storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=telecom-assets
